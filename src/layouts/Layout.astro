---
import '../styles/global.css';
const { pageTitle } = Astro.props;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@300;400;500;600&display=swap"
    />
    <title>{pageTitle}</title>
	<meta name="description" content="Musique électronique de Gabriel Klopzig — sorties, concerts et contact." />
	<link rel="canonical" href="https://gabrielklopzig.com/" />
	<meta property="og:title" content="Gabriel Klopzig — Site officiel" />
	<meta property="og:description" content="Musique électronique de Gabriel Klopzig." />
	<meta property="og:url" content="https://gabrielklopzig.com/" />
	<meta property="og:type" content="website" />
  </head>
  <body>
	<slot />
  </body>
</html>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gabriel Klopzig",
  "jobTitle": "Musicien",
  "url": "https://gabrielklopzig.com",
  "sameAs": [
    "https://open.spotify.com/artist/21QITMcVcc0oQGVrcZniNk",
    "https://music.youtube.com/channel/UCr3j4ggAHhLgJN29p1_JKXg",
    "https://klopzig.bandcamp.com/",
  ]
}
</script>